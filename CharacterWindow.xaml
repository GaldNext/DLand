<Window x:Class="DLand.CharacterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DLand"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="DLand"
        WindowState="Maximized"
        d:Height="800" d:Width="1200"
        Background="{StaticResource MaterialDesignPaper}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="230" MaxWidth="500"/>
            <ColumnDefinition Width="*" MinWidth="500"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="270" MinHeight="50"/>
            <RowDefinition MinHeight="50"/>
            <RowDefinition Height="50" MaxHeight="50"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Column="0" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <Image x:Name="HeroImage" Height="230" Width="230" Stretch="Fill" Margin="10, 10, 10, 0" Source="/tenebris-Portrait.png">
                    <Image.Clip>
                        <RectangleGeometry RadiusX="15" RadiusY="15" Rect="0,0,230,224"/>
                    </Image.Clip>
                </Image>
                <Border x:Name="ImageEdit" Cursor="Hand" CornerRadius="10" Background="#AF3C3E3E" HorizontalAlignment="Right" Margin="0,-35,0,0">
                    <md:PackIcon Kind="ImagePlus"  Width="30" Height="30" Margin="5" Foreground="#FFD6D6D6"/>
                </Border>
            </StackPanel>
            
        </ScrollViewer>
        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border Margin="5" Grid.Column="0" Grid.Row="0" CornerRadius="35" Background="#FF1B1B1B">
                <StackPanel Margin="15" VerticalAlignment="Center">
                    <md:PackIcon Kind="Person"  Width="30" Height="30" Margin="0,0,0,0" VerticalContentAlignment="Top" Foreground="#FF009688"/>
                    <Border x:Name="CharEdit" Cursor="Hand" CornerRadius="10" Background="#AF3C3E3E" HorizontalAlignment="Right" Margin="0,-35,0,0">
                        <md:PackIcon Kind="BookEdit"  Width="30" Height="30" Margin="5" Foreground="#FFD6D6D6"/>
                    </Border>
                    <Border x:Name="CharConf" Cursor="Hand" CornerRadius="10" Background="#AF3C3E3E" HorizontalAlignment="Right" Margin="0,-35,0,0">
                        <md:PackIcon Kind="Check"  Width="30" Height="30" Margin="5" Foreground="#FF00962C"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ID:" FontSize="18"/>
                        <TextBlock x:Name="ID" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBlock Text="ОП:" FontSize="18" Margin="10,0,0,0"/>
                        <TextBlock x:Name="OP1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="OP2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Имя:" FontSize="18"/>
                        <TextBlock x:Name="Name1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Name2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Раса:" FontSize="18"/>
                        <TextBlock x:Name="Race1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Race2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Класс:" FontSize="18"/>
                        <TextBlock x:Name="Class1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Class2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Профессия:" FontSize="18"/>
                        <TextBlock x:Name="Profession1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Profession2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <Border x:Name="CharDel" Cursor="Hand" CornerRadius="10" Background="#AF3C3E3E" HorizontalAlignment="Right" Margin="0,-40,0,0">
                        <md:PackIcon Kind="TrashCan"  Width="30" Height="30" Margin="5" Foreground="#FF962900"/>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <ScrollViewer Grid.Column="0" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border Margin="5" Grid.Column="0" Grid.Row="0" CornerRadius="35" Background="#FF1B1B1B">
                <StackPanel Margin="15" VerticalAlignment="Center">
                    <md:PackIcon Kind="AccountCard"  Width="30" Height="30" Margin="0,0,0,0" VerticalContentAlignment="Top" Foreground="#FF009688"/>
                    <Border x:Name="StatEdit" Cursor="Hand" CornerRadius="10" Background="#AF3C3E3E" HorizontalAlignment="Right" Margin="0,-35,0,0">
                        <md:PackIcon Kind="BookEdit"  Width="30" Height="30" Margin="5" Foreground="#FFD6D6D6"/>
                    </Border>
                    <Border x:Name="StatConf" Cursor="Hand" CornerRadius="10" Background="#AF3C3E3E" HorizontalAlignment="Right" Margin="0,-35,0,0">
                        <md:PackIcon Kind="Check"  Width="30" Height="30" Margin="5" Foreground="#FF00962C"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Сила:" FontSize="18"/>
                        <TextBlock x:Name="Power1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Power2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Магия:" FontSize="18"/>
                        <TextBlock x:Name="Magic1"  Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Magic2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Стойкость:" FontSize="18"/>
                        <TextBlock x:Name="Durability1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Durability2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ловкость:" FontSize="18"/>
                        <TextBlock x:Name="Dexterity1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Dexterity2"  Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Мудрость:" FontSize="18"/>
                        <TextBlock x:Name="Wisdom1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Wisdom2"  Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Удача:" FontSize="18"/>
                        <TextBlock x:Name="Luck1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Luck2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Переносимый вес:" FontSize="18"/>
                        <TextBlock x:Name="Weight1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Weight2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Стрессоустойчивость:" FontSize="18"/>
                        <TextBlock x:Name="Stress1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Stress2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Скорость:" FontSize="18"/>
                        <TextBlock x:Name="Speed1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="Speed2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ХП:" FontSize="18"/>
                        <TextBlock x:Name="HP1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="HP2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="МП:" FontSize="18"/>
                        <TextBlock x:Name="MP1" Text="Значение" FontSize="18" Margin="10,0,0,0"/>
                        <TextBox x:Name="MP2" Text="Изменить" FontSize="18" Margin="10,0,5,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Margin="5" Grid.Column="0" Grid.Row="0" CornerRadius="35" Background="#FF1B1B1B">
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <md:PackIcon Kind="BookOpenPageVariant"  Width="30" Height="30" Margin="0,0,0,0" VerticalContentAlignment="Top" Foreground="#FF009688"/>
                        <Border x:Name="SpellAdd" Cursor="Hand" CornerRadius="10" Background="#AF3C3E3E" HorizontalAlignment="Right" Margin="0,-35,0,0">
                            <md:PackIcon Kind="PenPlus"  Width="30" Height="30" Margin="5" Foreground="#FF00962C"/>
                        </Border>
                        <WrapPanel x:Name="AbilitieWP" HorizontalAlignment="Center">
                            
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Margin="5" Grid.Column="0" Grid.Row="0" CornerRadius="35" Background="#FF1B1B1B">
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <md:PackIcon Kind="BagPersonal"  Width="30" Height="30" Margin="0,0,0,0"  Foreground="#FF009688"/>
                        <Border x:Name="EquAdd" Cursor="Hand" CornerRadius="10" Background="#AF3C3E3E" HorizontalAlignment="Right" Margin="0,-35,0,0">
                            <md:PackIcon Kind="PenPlus"  Width="30" Height="30" Margin="5" Foreground="#FF00962C"/>
                        </Border>
                        <WrapPanel x:Name="EquWP" HorizontalAlignment="Center">
                            
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
