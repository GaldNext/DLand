<Window x:Class="DLand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DLand"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="DLand"
        WindowState="Maximized"
        d:Height="800" d:Width="1200"
        Background="{StaticResource MaterialDesignPaper}"
        >

    <Grid>
        <TabControl Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="Вход" x:Name="Tab1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" MaxWidth="150"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="*" MinWidth="0" MaxWidth="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Column="1" Grid.Row="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Width="200" Height="80">
                                <md:PackIcon Kind="Person"  Width="20" Height="20" Margin="0,-10,-20,0" Foreground="#FF009688"/>
                                <TextBox Width="200" Height="35" Margin="0,20" TextAlignment="Center" x:Name="BoxLogin"  md:HintAssist.Hint="Логин" md:HintAssist.HintHorizontalAlignment="Center" md:HintAssist.IsFloating="True" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="200" Height="80">
                                <md:PackIcon Kind="Eye"  Width="20" Height="20" Margin="0,-10,-20,0" Foreground="#FF009688"/>
                                <TextBox Width="200" Height="35" TextAlignment="Center" x:Name="BoxPassword" md:HintAssist.Hint="Пароль" md:HintAssist.HintHorizontalAlignment="Center" md:HintAssist.IsFloating="True"/>
                            </StackPanel>
                            <Button Width="200" Height="50" Content="Вход" Margin="0,10,0,0" Click="Login"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Персонажи" x:Name="Tab2" MouseLeftButtonDown="Tab2_Button">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" MaxWidth="150"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="*" MinWidth="0" MaxWidth="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MaxHeight="40"/>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" MaxHeight="40"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Grid.Row="0">
                        <Label x:Name="CountLabel" Content="Найдено..." md:TextFieldAssist.HasLeadingIcon="True" md:TextFieldAssist.LeadingIcon="Magnify" Margin="5"/>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="0">
                        <TextBox x:Name="SearchBox" md:HintAssist.Hint="Поиск персонажей..." md:TextFieldAssist.HasLeadingIcon="True" md:TextFieldAssist.LeadingIcon="Magnify" TextChanged="SearchBox_TextChanged"/>
                    </Border>
                    <Border Grid.Column="0" Grid.Row="3">
                        <Button Content="Создать" md:TextFieldAssist.HasLeadingIcon="True" md:TextFieldAssist.LeadingIcon="Magnify"/>
                    </Border>
                    <ScrollViewer Grid.Column="0" Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                        <Border>
                            <StackPanel x:Name="UserHeroSP"></StackPanel>
                        </Border>
                    </ScrollViewer>
                    <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border>
                            <StackPanel>
                                <WrapPanel x:Name="HeroesAllSP" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
        <md:Snackbar x:Name="SnackbarPresenter" MessageQueue="{md:MessageQueue}" Width="600" Background="#FF009688"/>
        <Border Cursor="Hand" Background="#FF323232" Width="45" Height="45" x:Name="IconExit" HorizontalAlignment="Right" VerticalAlignment="Top" MouseLeftButtonDown="Exit">
            <md:PackIcon Kind="AccountArrowLeft" Width="45" Height="45" Foreground="#FF982929"/>
        </Border>
    </Grid>
</Window>
