<md:Card x:Name="HeroCard" Cursor="Hand" Width="250" Margin="10" UniformCornerRadius="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <StackPanel>
        <Image x:Name="HeroImage" Height="230" Width="230" Stretch="Fill" Margin="10, 10, 10, 0">
            <Image.Clip>
                <RectangleGeometry RadiusX="15" RadiusY="15" Rect="0,0,230,224"/>
            </Image.Clip>
        </Image>
        <TextBlock x:Name="HeroName" Text="Название" HorizontalAlignment="Center" Width="212" TextAlignment="Center" Margin="0, 0, 0, 5"/>
    </StackPanel>
</md:Card>

